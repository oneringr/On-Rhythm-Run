<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/brand_title"
                    android:textColor="@color/mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/mint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentModeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_calm"
                        android:textColor="@color/foam"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/currentBpmValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/zero_bpm"
                        android:textColor="@color/mint"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/bpmProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/compact_progress_drawable" />
            </LinearLayout>
        </LinearLayout>

        <com.runner.smartplayer.watch.ui.AlwaysMarqueeTextView
            android:id="@+id/displayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:requiresFadingEdge="horizontal"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="@string/track_not_ready"
            android:textColor="@color/foam"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/control_button_secondary"
                android:contentDescription="@string/previous"
                android:padding="10dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/foam" />

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="12dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/playProgressRing"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/mint"
                    app:indicatorSize="68dp"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="@color/foam"
                    app:trackThickness="4dp" />

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/control_button_primary"
                    android:contentDescription="@string/play_pause"
                    android:padding="13dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/foam" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/control_button_secondary"
                android:contentDescription="@string/next"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/foam" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/volumeDownButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="-"
                    android:textAllCaps="false"
                    android:textColor="@color/foam"
                    android:textSize="16sp"
                    app:backgroundTint="@color/surface_alt"
                    app:cornerRadius="12dp" />

                <ImageView
                    android:id="@+id/volumeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/volume_icon"
                    android:src="@drawable/ic_volume" />

                <ProgressBar
                    android:id="@+id/volumeProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/compact_progress_drawable" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/volumeUpButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textColor="@color/foam"
                    android:textSize="16sp"
                    app:backgroundTint="@color/surface_alt"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueModeButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/queue_mode_shuffle"
                android:textAllCaps="false"
                android:textColor="@color/mint"
                android:textSize="10sp"
                app:backgroundTint="@color/surface_alt"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/playlistOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30A1A24"
        android:clickable="true"
        android:contentDescription="@string/close_playlist"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playlistCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            app:cardBackgroundColor="@color/surface_alt"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/playlist_title"
                        android:textColor="@color/foam"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/closePlaylistButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/control_button_secondary"
                        android:contentDescription="@string/close_playlist"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/foam" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlistRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/playlistEmptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/playlist_empty"
                    android:textColor="@color/slate"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
