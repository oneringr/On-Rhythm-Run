<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adaptiveModeButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="@string/adaptive_mode_enabled"
            android:textAllCaps="false"
            android:textColor="@color/mint"
            app:backgroundTint="@color/surface_alt"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debugModeButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="@string/debug_mode_disabled"
            android:textAllCaps="false"
            android:textColor="@color/mint"
            app:backgroundTint="@color/surface_alt"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/current_playback_mode"
            android:textColor="@color/slate"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/currentModeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/label_calm"
            android:textColor="@color/mint"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/current_heart_rate"
            android:textColor="@color/slate"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/runModeHeartRateValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/placeholder_bpm"
            android:textColor="@color/foam"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runModeSensorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/player_panel_background"
            android:padding="12dp"
            android:text="@string/sensor_unavailable"
            android:textColor="@color/foam"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/player_panel_background"
            android:padding="12dp"
            android:text="@string/debug_mode_description"
            android:textColor="@color/foam"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/player_panel_background"
            android:padding="12dp"
            android:text="@string/threshold_description"
            android:textColor="@color/foam"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
