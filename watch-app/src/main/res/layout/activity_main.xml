<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/screen_horizontal_padding"
    android:paddingBottom="4dp">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playerTabButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:checkable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/player"
            android:textAllCaps="false"
            android:textColor="@color/bottom_tab_text_color"
            android:textSize="11sp"
            app:backgroundTint="@color/bottom_tab_background_tint"
            app:cornerRadius="14dp"
            app:strokeColor="@color/bottom_tab_stroke_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runModeTabButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:checkable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/run_mode"
            android:textAllCaps="false"
            android:textColor="@color/bottom_tab_text_color"
            android:textSize="11sp"
            app:backgroundTint="@color/bottom_tab_background_tint"
            app:cornerRadius="14dp"
            app:strokeColor="@color/bottom_tab_stroke_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/libraryTabButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:checkable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/library"
            android:textAllCaps="false"
            android:textColor="@color/bottom_tab_text_color"
            android:textSize="11sp"
            app:backgroundTint="@color/bottom_tab_background_tint"
            app:cornerRadius="14dp"
            app:strokeColor="@color/bottom_tab_stroke_color"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>
